# Database (MariaDB) — used by Prisma in src/lib/prisma.ts
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# Better Auth — generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET="your-auth-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Resend (contact form email) — src/app/api/contact/route.ts
RESEND_API_KEY="your-resend-api-key"
CONTACT_FROM_EMAIL="noreply@example.com"
CONTACT_TO_EMAIL="you@example.com"
